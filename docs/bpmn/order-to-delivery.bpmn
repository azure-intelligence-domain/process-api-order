<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OrderToDelivery" targetNamespace="https://github.com/azure-intelligence-domain/process-api-order">
  <bpmn:collaboration id="Collaboration_OrderToDelivery">
    <bpmn:participant id="Participant_OrderToDelivery" name="Order to delivery (ACME order 4711)" processRef="OrderToDelivery" />
  </bpmn:collaboration>
  <bpmn:process id="OrderToDelivery" isExecutable="false">
    <bpmn:laneSet id="LaneSet_OrderToDelivery">
      <bpmn:lane id="Lane_Sales" name="Sales · Salesforce">
        <bpmn:flowNodeRef>Start_ClosedWon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Order" name="Order domain">
        <bpmn:flowNodeRef>Event_OrderPlaced</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_OrderConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Erp" name="ERP · SAP">
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance">
        <bpmn:flowNodeRef>Task_Invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_OrderInvoiced</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_OrderPaid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehouse · WMS">
        <bpmn:flowNodeRef>Task_Reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Ready</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Logistics" name="3PL partner">
        <bpmn:flowNodeRef>Task_Ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Shipped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Delivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_ClosedWon" name="Opportunity closed-won">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_PlaceOrder" name="Place order">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Event_OrderPlaced" name="OrderPlaced">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Message_Event_OrderPlaced" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="Task_Confirm" name="Check credit and availability">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Accepted" name="Accepted?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rejected" name="OrderRejected">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:messageEventDefinition id="Message_End_Rejected" />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="Event_OrderConfirmed" name="OrderConfirmed">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Message_Event_OrderConfirmed" />
    </bpmn:intermediateThrowEvent>
    <bpmn:parallelGateway id="Gateway_Split" name="">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_Invoice" name="Issue invoice">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="Event_OrderInvoiced" name="OrderInvoiced">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Message_Event_OrderInvoiced" />
    </bpmn:intermediateThrowEvent>
    <bpmn:receiveTask id="Task_Payment" name="Receive payment">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:intermediateThrowEvent id="Event_OrderPaid" name="OrderPaid">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Message_Event_OrderPaid" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="Task_Reserve" name="Reserve stock">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="Event_Ready" name="OrderReadyForShipment">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Message_Event_Ready" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="Task_Ship" name="Request and dispatch shipment">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="Event_Shipped" name="OrderShipped">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Message_Event_Shipped" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="Task_Deliver" name="Deliver to customer">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="Event_Delivered" name="OrderDelivered">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Message_Event_Delivered" />
    </bpmn:intermediateThrowEvent>
    <bpmn:parallelGateway id="Gateway_Join" name="">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End_Completed" name="OrderCompleted">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:messageEventDefinition id="Message_End_Completed" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" name="" sourceRef="Start_ClosedWon" targetRef="Task_PlaceOrder" />
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="Task_PlaceOrder" targetRef="Event_OrderPlaced" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="Event_OrderPlaced" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="Task_Confirm" targetRef="Gateway_Accepted" />
    <bpmn:sequenceFlow id="Flow_4" name="no" sourceRef="Gateway_Accepted" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_5" name="yes" sourceRef="Gateway_Accepted" targetRef="Event_OrderConfirmed" />
    <bpmn:sequenceFlow id="Flow_6" name="" sourceRef="Event_OrderConfirmed" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="Gateway_Split" targetRef="Task_Invoice" />
    <bpmn:sequenceFlow id="Flow_8" name="" sourceRef="Task_Invoice" targetRef="Event_OrderInvoiced" />
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="Event_OrderInvoiced" targetRef="Task_Payment" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="Task_Payment" targetRef="Event_OrderPaid" />
    <bpmn:sequenceFlow id="Flow_11" name="" sourceRef="Event_OrderPaid" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_12" name="" sourceRef="Gateway_Split" targetRef="Task_Reserve" />
    <bpmn:sequenceFlow id="Flow_13" name="" sourceRef="Task_Reserve" targetRef="Event_Ready" />
    <bpmn:sequenceFlow id="Flow_14" name="stock-to-3pl" sourceRef="Event_Ready" targetRef="Task_Ship" />
    <bpmn:sequenceFlow id="Flow_15" name="" sourceRef="Task_Ship" targetRef="Event_Shipped" />
    <bpmn:sequenceFlow id="Flow_16" name="" sourceRef="Event_Shipped" targetRef="Task_Deliver" />
    <bpmn:sequenceFlow id="Flow_17" name="" sourceRef="Task_Deliver" targetRef="Event_Delivered" />
    <bpmn:sequenceFlow id="Flow_18" name="" sourceRef="Event_Delivered" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_19" name="" sourceRef="Gateway_Join" targetRef="End_Completed" />
  </bpmn:process>
